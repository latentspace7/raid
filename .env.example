# Reddit application credentials
CLIENT_ID=your_reddit_client_id
CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=python:reddit-ai-digest:0.1.0

# Model endpoint; OPEN_AI_TOKEN is accepted as a legacy API key name
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano-2025-08-07

# For a local Responses API server, set its URL/model and remove OPENAI_API_KEY
# OPENAI_BASE_URL=http://localhost:8080

# Gmail sender, app password, and one recipient
GMAIL_EMAIL=sender@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
TO_EMAIL=recipient@example.com

# Required for POST /digest; use a random secret. Omit for CLI-only use.
DIGEST_API_TOKEN=replace_with_a_random_secret

DIGEST_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
