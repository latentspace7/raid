# Reddit API Credentials
# Get these from https://www.reddit.com/prefs/apps
# Create a "script" type application
CLIENT_ID=your_reddit_client_id_here
CLIENT_SECRET=your_reddit_client_secret_here

# OpenAI API Token
# Get from https://platform.openai.com/api-keys
OPEN_AI_TOKEN=your_openai_api_key_here

# Gmail Configuration
# Use your Gmail address and an app-specific password
# Enable 2FA first, then generate app password at https://myaccount.google.com/apppasswords
GMAIL_EMAIL=your_email
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Email Recipients
TO_EMAIL=your_email
